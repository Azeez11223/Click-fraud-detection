# ── Required ──────────────────────────────────────────────────────────────────
JWT_SECRET=your-secret-key-at-least-32-characters-long

# ── Database ──────────────────────────────────────────────────────────────────
# Neon Postgres (production) — pooled connection string with sslmode=require
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# Leave unset for local SQLite development

# ── Environment ───────────────────────────────────────────────────────────────
ENV=development
# ENV=production  # disables /docs, /train, uses strict CORS

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:8501

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_EMAILS=admin@example.com

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_EXPIRE_MINUTES=60

# ── Model ─────────────────────────────────────────────────────────────────────
# MODEL_URL=https://github.com/your-org/adshield/releases/download/v1.0/model.json
# MODEL_SHA256=abc123...

# ── Fraud Thresholds ──────────────────────────────────────────────────────────
FRAUD_REVIEW_THRESHOLD=0.3
FRAUD_BLOCK_THRESHOLD=0.7
C_FP=1.0
C_FN=10.0

# ── Retention ─────────────────────────────────────────────────────────────────
RETENTION_DAYS=90

# ── Rate Limits ───────────────────────────────────────────────────────────────
# (configured in code, slowapi — single instance in-memory)

# ── Observability ─────────────────────────────────────────────────────────────
# SENTRY_DSN=https://key@sentry.io/project

# ── Frontend (Streamlit) ──────────────────────────────────────────────────────
API_BASE=http://localhost:8000
