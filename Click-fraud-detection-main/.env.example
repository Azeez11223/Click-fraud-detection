# ── Required ──────────────────────────────────────────────────────────────────
JWT_SECRET=your-secret-key-at-least-32-characters-long

# ── Database ──────────────────────────────────────────────────────────────────
# Neon Postgres (production) — pooled connection string with sslmode=require
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# Leave unset for local SQLite development

# ── Environment ───────────────────────────────────────────────────────────────
ENV=development
# ENV=production  # disables /docs, /train, uses strict CORS

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:8501
FORWARDED_ALLOW_IPS=127.0.0.1

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_EMAILS=admin@example.com

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_EXPIRE_MINUTES=60

# ── Model ─────────────────────────────────────────────────────────────────────
# MODEL_URL=https://github.com/your-org/adshield/releases/download/v1.0/model.json
# MODEL_SHA256=abc123...

# ── Fraud Thresholds ──────────────────────────────────────────────────────────
FRAUD_REVIEW_THRESHOLD=0.3
FRAUD_BLOCK_THRESHOLD=0.7
C_FP=1.0
C_FN=10.0

# ── Retention ─────────────────────────────────────────────────────────────────
RETENTION_DAYS=90

# ── Rate Limits ───────────────────────────────────────────────────────────────
# (configured in code, slowapi — single instance in-memory)
AUTH_RATE_LIMIT=5/minute
INGEST_RATE_LIMIT=60/minute
UPLOAD_RATE_LIMIT=5/minute
IP_REVIEW_CLICK_THRESHOLD=5
IP_BLOCK_CLICK_THRESHOLD=20
IP_REVIEW_5MIN_THRESHOLD=10
UA_REVIEW_10MIN_THRESHOLD=15

# ── Observability ─────────────────────────────────────────────────────────────
# SENTRY_DSN=https://key@sentry.io/project
SENTRY_DSN=

# Streamlit frontend
API_BASE=http://localhost:8000

# Model cache
MODEL_PATH=models/model.json
MODEL_VERSION=local

# ── Frontend (Streamlit) ──────────────────────────────────────────────────────
API_BASE=http://localhost:8000
